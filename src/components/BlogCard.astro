---
import type { Post } from '../data/content';
const { post, compact = false } = Astro.props as { post: Post; compact?: boolean };
---

<article class:list={['rounded-xl border border-line bg-white', compact ? 'p-5' : 'p-6']}>
  <p class="text-sm font-semibold text-accent">{post.date}</p>
  <h3 class:list={[compact ? 'text-lg' : 'text-xl', 'mt-3 font-bold leading-snug tracking-tight text-ink']}>{post.title}</h3>
  <p class="mt-3 max-w-xl text-base leading-7 text-muted">{post.excerpt}</p>
  {post.href && <a class="mt-5 inline-block font-semibold text-accent hover:text-accent-dark" href={post.href}>Read article</a>}
</article>
