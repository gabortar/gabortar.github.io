---
interface Props { eyebrow: string; title: string; copy?: string; }
const { eyebrow, title, copy } = Astro.props;
---

<div class="mb-8 max-w-3xl md:mb-10">
  <p class="mb-3 text-base font-semibold text-accent">{eyebrow}</p>
  <h2 class="text-3xl font-bold leading-tight tracking-[-0.025em] text-ink sm:text-4xl">{title}</h2>
  {copy && <p class="mt-4 max-w-2xl text-lg leading-8 text-muted">{copy}</p>}
</div>
