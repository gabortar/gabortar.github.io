---
interface Props { number: string; title: string; description: string; centered?: boolean; }
const { number, title, description, centered = false } = Astro.props;
---

<article class="rounded-xl border border-line bg-white p-6 shadow-[0_1px_2px_rgba(32,36,31,0.04)]">
  <div class:list={[centered ? 'flex flex-col items-center text-center' : 'flex items-start gap-4']}>
    <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-accent-soft text-sm font-bold text-accent">{number}</span>
    <div>
      <h3 class:list={[centered ? 'mt-4' : '', 'text-xl font-bold leading-snug tracking-tight text-ink']}>{title}</h3>
      <p class="mt-3 text-base leading-7 text-muted">{description}</p>
    </div>
  </div>
</article>
