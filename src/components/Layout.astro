---
import Header from './Header.astro';
import Footer from './Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  hideFooter?: boolean;
}

const htmlLang = Astro.url.pathname === '/hu/' || Astro.url.pathname.startsWith('/hu/') ? 'hu' : 'en';
const defaultDescriptions = {
  en: 'Practical software, workflow automation, data tools, and AI-assisted systems for teams dealing with manual processes and disconnected tools.',
  hu: 'Gyakorlati szoftveres megoldások, folyamatautomatizálás, adateszközök és AI-alapú rendszerek manuális vagy széteső folyamatokra.',
};

const {
  title = 'Gabor Tar | Software, Automation & AI',
  description = defaultDescriptions[htmlLang],
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-image.png',
  hideFooter = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const normalizedPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const englishPath = normalizedPath === '/hu/' ? '/' : normalizedPath.startsWith('/hu/') ? normalizedPath.replace(/^\/hu/, '') || '/' : normalizedPath;
const localizedPaths = new Set(['/', '/about/', '/work/']);
const alternateURLs = localizedPaths.has(englishPath)
  ? {
      en: new URL(englishPath, Astro.site),
      hu: new URL(`/hu${englishPath === '/' ? '/' : englishPath}`, Astro.site),
      xDefault: new URL(englishPath, Astro.site),
    }
  : null;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternateURLs && (
      <>
        <link rel="alternate" hreflang="en" href={alternateURLs.en} />
        <link rel="alternate" hreflang="hu" href={alternateURLs.hu} />
        <link rel="alternate" hreflang="x-default" href={alternateURLs.xDefault} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:site_name" content="Gabor Tar" />
    <meta name="twitter:card" content="summary" />
    <title>{title}</title>
  </head>
  <body>
    <a href="#main-content" class="fixed left-4 top-4 z-50 -translate-y-24 bg-accent px-4 py-2 font-semibold text-ink focus:translate-y-0">Skip to content</a>
    <Header />
    <main id="main-content"><slot /></main>
    {!hideFooter && <Footer />}
  </body>
</html>
