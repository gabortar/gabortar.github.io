---
import type { Project } from '../data/content';
const { project } = Astro.props as { project: Project; index?: number; compact?: boolean };
---

<article class="group rounded-xl border border-line bg-white p-6 shadow-[0_1px_2px_rgba(32,36,31,0.04)] transition hover:-translate-y-0.5 hover:border-accent/50 hover:shadow-[0_10px_24px_rgba(32,36,31,0.07)]">
  <div class="flex min-h-full flex-col">
    <h2 class="text-2xl font-bold tracking-[-0.025em] text-ink">{project.title}</h2>
    <p class="mt-3 text-base leading-7 text-muted">{project.description}</p>
    <div class="mt-5 border-t border-line pt-4">
      <p class="text-xs font-bold uppercase tracking-[0.12em] text-accent">Demonstrates</p>
      <ul class="mt-3 space-y-2 text-sm leading-6 text-muted">
        {project.demonstrates.map((item) => (
          <li class="flex gap-2">
            <span class="mt-[0.6em] size-1.5 shrink-0 rounded-full bg-accent/50"></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
      {project.tags.map((tag) => <li class="rounded-md border border-line/70 bg-paper/70 px-2.5 py-1 text-xs font-medium text-muted">{tag}</li>)}
    </ul>
    {project.href && <a href={project.href} class="mt-6 inline-block font-semibold text-accent hover:text-accent-dark">View project <span aria-hidden="true">-&gt;</span></a>}
  </div>
</article>
