---
const pathname = Astro.url.pathname;
const isHungarian = pathname === '/hu/' || pathname.startsWith('/hu/');
const isHome = pathname === '/' || pathname === '/hu/';
const languageHref = isHungarian ? pathname.replace(/^\/hu/, '') || '/' : `/hu${pathname === '/' ? '/' : pathname}`;
const languageLabel = isHungarian ? 'EN' : 'HU';
const homeHref = isHungarian ? '/hu/' : '/';
const links = isHungarian
  ? [
      { href: '/hu/', label: 'Kezdőlap' },
      { href: '/hu/work/', label: 'Munkáim' },
      { href: '/hu/about/', label: 'Rólam' },
    ]
  : [
      { href: '/', label: 'Home' },
      { href: '/work/', label: 'Work' },
      { href: '/about/', label: 'About' },
    ];
---

<header id="site-header" class="site-header" data-home={isHome ? 'true' : 'false'}>
  <div class="shell site-header__inner">
    <a href={homeHref} class="site-header__brand" aria-label="Gabor Tar, home">
      <span class="site-header__mark">GT</span>
      <span class="site-header__name">Gabor Tar</span>
    </a>
    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__nav-list">
        {links.map((link) => {
          const active = pathname === link.href || pathname === link.href.replace(/\/$/, '');
          return (
            <li>
              <a href={link.href} aria-current={active ? 'page' : undefined} class:list={['site-header__link', active && 'site-header__link--active']}>
                {link.label}
              </a>
            </li>
          );
        })}
        <li>
          <a href={languageHref} class="site-header__lang" aria-label={isHungarian ? 'Switch to English' : 'Switch to Hungarian'}>{languageLabel}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  const getScrollThreshold = () => {
    if (header?.dataset.home !== 'true') {
      return 32;
    }

    return Number.POSITIVE_INFINITY;
  };

  const setHeaderState = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > getScrollThreshold());
    header?.classList.toggle('is-on-hero', header.dataset.home === 'true' && window.scrollY < window.innerHeight * 0.55);
  };

  setHeaderState();
  window.addEventListener('DOMContentLoaded', setHeaderState);
  window.addEventListener('resize', setHeaderState);
  window.addEventListener('scroll', setHeaderState, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    border-bottom: 1px solid var(--color-line);
    background: rgba(251, 249, 243, 0.96);
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  :global(main) {
    padding-top: 7rem;
  }

  .site-header__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    text-align: center;
    transition:
      padding 180ms ease,
      gap 180ms ease;
  }

  .site-header__brand {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-ink);
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    transition:
      gap 180ms ease,
      color 180ms ease;
  }

  .site-header__mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--color-accent);
    color: white;
    font-size: 0.875rem;
    line-height: 1;
    transition:
      width 180ms ease,
      height 180ms ease,
      border-radius 180ms ease,
      background-color 180ms ease;
  }

  .site-header__brand:hover .site-header__mark {
    background: var(--color-accent-dark);
  }

  .site-header__name {
    font-size: 1rem;
    line-height: 1.25;
    transition: font-size 180ms ease;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    color: var(--color-muted);
    font-size: 0.95rem;
    font-weight: 500;
    list-style: none;
    margin: 0;
    padding: 0;
    transition:
      gap 180ms ease,
      font-size 180ms ease,
      color 180ms ease;
  }

  .site-header__link {
    border-radius: 0.125rem;
    color: inherit;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .site-header__link:hover {
    color: var(--color-ink);
  }

  .site-header__link--active {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.25rem;
  }

  .site-header__lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.75rem;
    color: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    opacity: 0.92;
    transition: color 160ms ease, opacity 160ms ease;
  }

  .site-header__lang:hover {
    color: var(--color-ink);
    opacity: 1;
  }

  .site-header.is-on-hero {
    border-bottom-color: rgba(244, 241, 233, 0.28);
    background: rgba(120, 135, 120, 0.96);
  }

  .site-header.is-on-hero .site-header__brand {
    color: #fffdf6;
  }

  .site-header.is-on-hero .site-header__mark {
    background: #fbf9f3;
    color: #354031;
  }

  .site-header.is-on-hero .site-header__brand:hover .site-header__mark {
    background: #f4f1e9;
  }

  .site-header.is-on-hero .site-header__nav-list {
    color: rgba(255, 253, 246, 0.84);
  }

  .site-header.is-on-hero .site-header__link:hover,
  .site-header.is-on-hero .site-header__link--active {
    color: #fffdf6;
  }

  .site-header.is-on-hero .site-header__lang {
    color: rgba(255, 253, 246, 0.84);
  }

  .site-header.is-on-hero .site-header__lang:hover {
    color: #fffdf6;
  }

  .site-header.is-scrolled .site-header__inner {
    flex-direction: row;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.55rem;
    text-align: left;
  }

  .site-header.is-scrolled .site-header__brand {
    flex-direction: row;
    gap: 0.6rem;
  }

  .site-header.is-scrolled .site-header__mark {
    width: 2rem;
    height: 2rem;
    border-radius: 0.45rem;
    font-size: 0.8125rem;
  }

  .site-header.is-scrolled .site-header__name {
    font-size: 0.95rem;
  }

  .site-header.is-scrolled .site-header__nav-list {
    gap: 1.05rem;
    font-size: 0.9rem;
  }

  @media (min-width: 640px) {
    .site-header__nav-list {
      gap: 1.75rem;
    }

    .site-header.is-scrolled .site-header__nav-list {
      gap: 1.5rem;
    }
  }

  @media (max-width: 767px) {
    .site-header {
      position: static;
    }

    :global(main) {
      padding-top: 0;
    }

    .site-header__inner {
      gap: 0.55rem;
      padding-block: 0.75rem;
    }

    .site-header__brand {
      gap: 0.35rem;
    }

    .site-header__mark {
      width: 2rem;
      height: 2rem;
      border-radius: 0.45rem;
      font-size: 0.8125rem;
    }

    .site-header__name {
      font-size: 0.95rem;
    }

    .site-header__nav-list {
      gap: 0.85rem;
      font-size: 0.875rem;
    }

    .site-header__lang {
      font-size: 0.8rem;
    }

    .site-header.is-on-hero {
      border-bottom-color: var(--color-line);
      background: rgba(251, 249, 243, 0.96);
    }

    .site-header.is-on-hero .site-header__brand {
      color: var(--color-ink);
    }

    .site-header.is-on-hero .site-header__mark {
      background: var(--color-accent);
      color: white;
    }

    .site-header.is-on-hero .site-header__nav-list {
      color: var(--color-muted);
    }

    .site-header.is-on-hero .site-header__link:hover,
    .site-header.is-on-hero .site-header__link--active {
      color: var(--color-accent);
    }
  }

  @media (max-width: 380px) {
    .site-header.is-scrolled .site-header__inner {
      gap: 0.75rem;
    }

    .site-header.is-scrolled .site-header__name {
      font-size: 0.9rem;
    }

    .site-header.is-scrolled .site-header__nav-list {
      gap: 0.7rem;
      font-size: 0.875rem;
    }
  }
</style>
