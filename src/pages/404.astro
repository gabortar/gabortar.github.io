---
import Layout from '../components/Layout.astro';
---

<Layout title="Gabor Tar | Page Not Found" description="The requested page could not be found.">
  <section class="shell grid min-h-[65svh] place-items-center py-16 text-center">
    <div>
      <p class="text-lg font-bold text-accent">404</p>
      <h1 class="mt-3 text-4xl font-bold tracking-[-0.035em] sm:text-5xl">Nothing here yet.</h1>
      <p class="mx-auto mt-4 max-w-md text-lg leading-8 text-muted">The page may have moved, or the link may be incomplete.</p>
      <a href="/" class="mt-7 inline-block rounded-lg bg-accent px-5 py-3.5 font-semibold text-white hover:bg-accent-dark">Back to home</a>
    </div>
  </section>
</Layout>
