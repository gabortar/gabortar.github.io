---
import Layout from '../components/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { services } from '../data/content';

const processSteps = [
  {
    title: 'Find the bottleneck',
    text: 'Dig into the manual scripts, legacy code, or messy sheets that are holding your team back.',
    icon: 'workflow',
  },
  {
    title: 'Build the core',
    text: 'Strip away the fluff and deploy a minimal, high-impact version that gets the job done right now.',
    icon: 'prototype',
  },
  {
    title: 'Leave it better',
    text: 'Hand over clean architecture and explicit documentation so it’s easy to scale and maintain.',
    icon: 'document',
  },
];
---

<Layout title="Gabor Tar — Practical AI and data automation" description="Practical AI and data automation for small teams: reporting workflows, Python and SQL automation, internal tools, and RAG prototypes." hideFooter>
  <div class="home-snap">
  <section class="snap-section home-screen home-hero border-b border-line reveal-section" data-reveal-section>
    <div class="shell home-screen__inner home-screen__inner--hero reveal-item">
      <h1 class="mx-auto max-w-4xl text-center text-4xl font-bold leading-tight tracking-[-0.04em] sm:text-5xl lg:text-6xl">
        Better software for <span class="messy-word" aria-label="messy"><span aria-hidden="true">m</span><span aria-hidden="true">e</span><span aria-hidden="true">s</span><span aria-hidden="true">s</span><span aria-hidden="true">y</span></span> workflows.
      </h1>
      <p class="mx-auto mt-5 max-w-3xl text-center text-xl leading-8">I build, improve, and connect backend systems, internal tools, automations, and AI-assisted workflows for teams dealing with manual processes, legacy software, and disconnected tools.</p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/work/" class="hero-button-primary rounded-lg px-5 py-3.5 text-center font-semibold transition-colors">See what I build</a>
        <a href="mailto:gabor@gabortar.eu" class="hero-button-secondary rounded-lg border px-5 py-3.5 text-center font-semibold transition-colors">Email me</a>
      </div>
      <p class="mt-4 text-center text-sm font-medium">Based in Hungary. Available for remote project work across Europe.</p>
    </div>
  </section>

  <section id="services" class="snap-section home-screen scroll-mt-16 border-b border-line bg-paper reveal-section" aria-labelledby="services-heading" data-reveal-section>
    <div class="shell home-screen__inner">
      <div class="mx-auto mb-8 max-w-3xl text-center reveal-item">
        <h2 id="services-heading" class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl">Capabilities</h2>
        <p class="mt-3 text-lg leading-8 text-muted">Engineering tailored solutions for data, backend infrastructure, and automation.</p>
      </div>
      <div class="grid gap-5 md:grid-cols-3">
        {services.map((service, index) => (
          <div class="reveal-item" style={`transition-delay: ${70 + index * 60}ms`}>
            <ServiceCard {...service} centered />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="snap-section home-screen border-b border-line bg-panel reveal-section" aria-labelledby="process-heading" data-reveal-section>
    <div class="shell home-screen__inner">
      <div class="mx-auto mb-8 max-w-3xl text-center reveal-item">
        <h2 id="process-heading" class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl">The process</h2>
        <p class="mt-3 text-lg leading-8 text-muted">Move fast, avoid tech debt, and solve the right problem.</p>
      </div>
      <div class="process-timeline">
        {processSteps.map((step, index) => (
          <article class="process-step" style={`--step-delay: ${140 + index * 210}ms`}>
            {step.icon === 'workflow' && (
              <svg class="process-step__icon" viewBox="0 0 56 56" aria-hidden="true">
                <path d="M14 18h12v10H14zM31 11h12v10H31zM32 35h13v10H32z" />
                <path d="M26 23h6M37 21v14M20 28v8h12" />
                <circle cx="20" cy="23" r="2" /><circle cx="37" cy="16" r="2" /><circle cx="38.5" cy="40" r="2" />
              </svg>
            )}
            {step.icon === 'prototype' && (
              <svg class="process-step__icon" viewBox="0 0 56 56" aria-hidden="true">
                <path d="M15 15h12v11H15zM30 30h12v11H30z" />
                <path d="M21 26v8a6 6 0 0 0 6 6h3M27 20h6a7 7 0 0 1 7 7v3" />
                <path d="m37 25 3 5 3-5M25 36l5 4-5 4" />
              </svg>
            )}
            {step.icon === 'document' && (
              <svg class="process-step__icon" viewBox="0 0 56 56" aria-hidden="true">
                <path d="M18 10h16l8 8v28H18z" />
                <path d="M34 10v9h8M23 25h13M23 31h10M23 37h8" />
                <path d="m33 39 4 4 8-10" />
              </svg>
            )}
            <p class="process-step__number">{String(index + 1).padStart(2, '0')}</p>
            <h3 class="process-step__title mt-4 text-xl font-bold leading-snug tracking-tight text-ink">{step.title}</h3>
            <p class="process-step__text mt-3 text-base leading-7 text-muted">{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="snap-section home-screen home-screen--contact bg-paper reveal-section" aria-labelledby="contact-heading" data-reveal-section>
    <div class="shell home-screen__inner home-screen__inner--contact">
      <div class="mx-auto max-w-3xl text-center reveal-item">
        <h2 id="contact-heading" class="text-3xl font-bold tracking-[-0.025em] sm:text-4xl">Let’s streamline your operations.</h2>
        <p class="mx-auto mt-3 max-w-2xl text-lg leading-8 text-muted">If you have a manual process slowing your team down, or systems that don’t talk to each other, let’s discuss a practical software solution.</p>
        <a class="mt-6 inline-block rounded-lg bg-accent px-5 py-3.5 font-semibold text-white transition-colors hover:bg-accent-dark" href="mailto:gabor@gabortar.eu">Let’s talk</a>
        <p class="mt-6 text-base font-medium">
          <a class="text-accent underline decoration-accent/30 underline-offset-4 hover:text-accent-dark" href="mailto:gabor@gabortar.eu">gabor@gabortar.eu</a>
          <span class="px-2 text-muted">·</span>
          <a class="text-accent underline decoration-accent/30 underline-offset-4 hover:text-accent-dark" href="https://www.linkedin.com/" rel="me noreferrer">LinkedIn</a>
        </p>
      </div>
    </div>
    <footer class="home-slide-footer border-t border-line bg-panel py-8 text-base text-muted">
      <div class="shell text-center">
        <p>&copy; {new Date().getFullYear()} Gabor Tar · <a class="font-medium hover:text-ink" href="https://github.com/gabortar" rel="me noreferrer">GitHub</a></p>
      </div>
    </footer>
  </section>
  </div>
</Layout>

<script>
  document.documentElement.classList.add('has-reveal');
  const revealSections = document.querySelectorAll('[data-reveal-section]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (reduceMotion || !('IntersectionObserver' in window)) {
    revealSections.forEach((section) => section.classList.add('is-visible'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.24, rootMargin: '0px 0px -12% 0px' },
    );

    revealSections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  :global(html) {
    --home-header-height: 7rem;
    --home-slide-height: 100svh;
    --home-slide-optical-offset: clamp(1.5rem, 3vh, 2.75rem);
  }

  :global(html) {
    scroll-padding-top: 0;
    scroll-snap-type: y mandatory;
  }

  :global(main) {
    padding-top: 0;
  }

  :global(body) {
    overscroll-behavior-y: contain;
  }

  .home-snap {
    scroll-snap-type: y mandatory;
  }

  .snap-section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .home-screen {
    box-sizing: border-box;
    min-height: var(--home-slide-height);
  }

  .home-hero {
    border-color: rgba(244, 241, 233, 0.28);
    background: #788778;
    color: #fbf9f3;
  }

  .home-hero {
    min-height: var(--home-slide-height);
  }

  .home-hero p {
    color: rgba(251, 249, 243, 0.78);
  }

  .hero-button-primary {
    background: #fbf9f3;
    color: #354031;
  }

  .hero-button-primary:hover {
    background: #f4f1e9;
  }

  .hero-button-secondary {
    border-color: rgba(251, 249, 243, 0.5);
    color: #fbf9f3;
  }

  .hero-button-secondary:hover {
    border-color: #fbf9f3;
    background: rgba(251, 249, 243, 0.08);
  }

  .home-screen__inner {
    display: flex;
    min-height: var(--home-slide-height);
    flex-direction: column;
    justify-content: center;
    box-sizing: border-box;
    padding: calc(var(--home-header-height) + 2rem) 0 4rem;
    transform: translateY(calc(-1 * var(--home-slide-optical-offset)));
  }

  .home-screen__inner--hero {
    min-height: var(--home-slide-height);
    transform: none;
  }

  .home-screen--contact {
    display: flex;
    flex-direction: column;
  }

  .home-screen__inner--contact {
    flex: 1;
    min-height: auto;
  }

  .home-slide-footer {
    flex: 0 0 auto;
  }

  .process-timeline {
    position: relative;
    display: grid;
    gap: 1.25rem;
  }

  .process-timeline::before {
    opacity: 0;
    transform-origin: left center;
    transition:
      opacity 700ms ease,
      transform 980ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.has-reveal) .process-timeline::before {
    transform: scaleX(0);
  }

  .reveal-section.is-visible .process-timeline::before {
    opacity: 1;
    transform: scaleX(1);
    transition-delay: 120ms;
  }

  .process-step {
    position: relative;
    z-index: 1;
    border-radius: 0.75rem;
    padding: 1.25rem;
    text-align: center;
  }

  .process-step__icon {
    display: block;
    width: 3.25rem;
    height: 3.25rem;
    margin: 0 auto 1rem;
    color: var(--color-accent);
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    opacity: 0.78;
  }

  .process-step__icon circle {
    fill: currentColor;
    stroke: none;
  }

  .process-step__number {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    margin-inline: auto;
    border-radius: 0.5rem;
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .process-step__icon,
  .process-step__number,
  .process-step__title,
  .process-step__text {
    transition:
      opacity 560ms ease,
      transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.has-reveal) .process-step__icon {
    opacity: 0;
    transform: translateY(10px);
  }

  :global(html.has-reveal) .process-step__number {
    opacity: 0;
    transform: scale(0.96);
  }

  :global(html.has-reveal) .process-step__title,
  :global(html.has-reveal) .process-step__text {
    opacity: 0;
    transform: translateY(8px);
  }

  .reveal-section.is-visible .process-step__icon {
    opacity: 0.78;
    transform: translateY(0);
    transition-delay: var(--step-delay);
  }

  .reveal-section.is-visible .process-step__number {
    opacity: 1;
    transform: scale(1);
    transition-delay: calc(var(--step-delay) + 80ms);
  }

  .reveal-section.is-visible .process-step__title,
  .reveal-section.is-visible .process-step__text {
    opacity: 1;
    transform: translateY(0);
    transition-delay: calc(var(--step-delay) + 150ms);
  }

  .reveal-item {
    transition:
      opacity 420ms ease,
      transform 420ms ease;
  }

  :global(html.has-reveal) .reveal-item {
    opacity: 0;
    transform: translateY(18px);
  }

  :global(html.has-reveal) .reveal-section.is-visible .reveal-item {
    opacity: 1;
    transform: translateY(0);
  }

  @media (min-width: 768px) and (min-height: 701px) {
    .home-screen,
    .home-hero {
      height: var(--home-slide-height);
      min-height: var(--home-slide-height);
      overflow: clip;
    }

    .home-screen__inner,
    .home-screen__inner--hero {
      height: 100%;
      min-height: 0;
      padding: calc(var(--home-header-height) + clamp(1.25rem, 3vh, 2.5rem)) 0 clamp(2rem, 5vh, 4rem);
    }

    .home-screen__inner--contact {
      height: auto;
      min-height: 0;
      padding: calc(var(--home-header-height) + clamp(1rem, 2vh, 2rem)) 0 clamp(1.5rem, 3vh, 2.5rem);
    }
  }

  @media (min-width: 768px) {
    .process-timeline {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2rem;
    }

    .process-timeline::before {
      position: absolute;
      top: 6.625rem;
      left: calc(16.666% + 1.5rem);
      right: calc(16.666% + 1.5rem);
      height: 1px;
      background: var(--color-line);
      content: '';
    }
  }

  @media (max-width: 767px) {
    :global(html) {
      scroll-snap-type: none;
    }

    .home-snap {
      scroll-snap-type: none;
    }

    .snap-section {
      scroll-snap-align: none;
      scroll-snap-stop: normal;
    }

    .home-screen,
    .home-hero,
    .home-screen__inner,
    .home-screen__inner--hero {
      height: auto;
      min-height: auto;
    }

    .home-hero {
      min-height: min(680px, calc(100svh - 1rem));
    }

    .home-screen__inner,
    .home-screen__inner--hero {
      padding-block: 3.5rem;
      transform: none;
    }

    .home-screen__inner--hero {
      min-height: min(680px, calc(100svh - 1rem));
      padding-block: 3rem;
    }

    .home-screen__inner--contact {
      padding-block: 3.5rem;
    }

    .home-hero h1 {
      font-size: clamp(2.35rem, 12vw, 3.35rem);
      line-height: 1.02;
    }

    .home-hero p {
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .home-hero .hero-button-primary,
    .home-hero .hero-button-secondary {
      width: 100%;
    }

    #services .grid {
      gap: 1rem;
    }

    #services :global(article) {
      padding: 1.25rem;
    }

    #services :global(h3) {
      font-size: 1.1rem;
    }

    #services :global(p) {
      font-size: 0.98rem;
      line-height: 1.65;
    }

    .process-timeline {
      gap: 0;
      margin-inline: auto;
      max-width: 28rem;
    }

    .process-timeline::before {
      position: absolute;
      top: 5.1rem;
      bottom: 1.15rem;
      left: 1.125rem;
      width: 1px;
      background: var(--color-line);
      content: '';
    }

    .process-step {
      padding: 0 0 1.5rem 4rem;
      text-align: left;
    }

    .process-step:last-child {
      padding-bottom: 0;
    }

    .process-step__number {
      position: absolute;
      top: 3.95rem;
      left: 0;
      margin-inline: 0;
      background: var(--color-accent-soft);
    }

    .process-step__icon {
      width: 2.75rem;
      height: 2.75rem;
      margin: 0 0 0.75rem;
    }

    #contact-heading,
    #process-heading,
    #services-heading {
      font-size: 2rem;
      line-height: 1.1;
    }

    #contact-heading + p,
    #process-heading + p,
    #services-heading + p {
      font-size: 1rem;
      line-height: 1.65;
    }

    .home-slide-footer {
      padding-block: 1.25rem;
      font-size: 0.95rem;
    }
  }

  @media (max-width: 480px) {
    .home-screen__inner,
    .home-screen__inner--hero {
      padding-block: 3rem;
    }
  }

  @media (min-width: 768px) and (max-height: 700px) {
    :global(html) {
      scroll-snap-type: y proximity;
    }

    .home-snap {
      scroll-snap-type: y proximity;
    }

    .home-screen,
    .home-hero,
    .home-screen__inner,
    .home-screen__inner--hero {
      height: auto;
      min-height: auto;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
      scroll-snap-type: none;
    }

    .home-snap {
      scroll-snap-type: none;
    }

    .reveal-item {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .process-timeline::before,
    .process-step__icon,
    .process-step__number,
    .process-step__title,
    .process-step__text {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .process-step__icon {
      opacity: 0.78;
    }

    .messy-word span {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
